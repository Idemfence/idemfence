{
  "name": "idemfence",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP idempotency-key middleware with fencing-token crash safety",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idemfence/idemfence.git",
    "directory": "packages/idemfence"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/stores/postgres/index.d.ts",
      "default": "./dist/stores/postgres/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "peerDependencies": {
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "2.1.4",
    "@types/pg": "8.23.1",
    "hono": "4.13.13",
    "pg": "8.23.1"
  }
}
