{
  "acknowledgeSideEffects": true,
  "headers": {
    "X-Principal": "conformance"
  },
  "keyMaxLength": 255,
  "requestBodyCap": 1048576,
  "keySyntax": "sf-string",
  "fixtures": {
    "create": {
      "method": "POST",
      "path": "/orders",
      "body": {
        "item": "widget"
      },
      "alternateBody": {
        "item": "gadget"
      }
    },
    "count": {
      "path": "/orders/count"
    },
    "slow": {
      "method": "POST",
      "path": "/orders",
      "body": {
        "item": "slow",
        "simulateWorkMs": 1500
      },
      "workMs": 1500
    },
    "release": {
      "method": "POST",
      "path": "/fixtures/release",
      "body": {
        "item": "widget"
      },
      "status": 429
    },
    "throws": {
      "method": "POST",
      "path": "/fixtures/throws",
      "body": {
        "item": "widget"
      }
    },
    "shortRetention": {
      "method": "POST",
      "path": "/fixtures/short-retention",
      "body": {
        "item": "widget"
      },
      "retentionMs": 1500
    },
    "passthrough": {
      "method": "POST",
      "path": "/fixtures/passthrough",
      "body": {
        "item": "widget"
      }
    },
    "noPrincipal": {
      "omitHeaders": ["X-Principal"]
    }
  }
}
