# Copy to .env (never commit .env). compose.yaml reads this file.

# Password for the compose-managed Postgres; also used in the app's DATABASE_URL.
POSTGRES_PASSWORD=change-me

# idemfence secret: at least 32 bytes. Generate one with: openssl rand -hex 32
IDEMFENCE_SECRET=

# Your published idempotency documentation (https). The contract is a placeholder here.
DOCS_URL=https://github.com/idemfence/idemfence/blob/main/docs/contract.md

# idemfence mode of every idempotent route: lease (default) or transactional.
IDEMFENCE_MODE=lease

# Host port the app is published on.
PORT=3000
